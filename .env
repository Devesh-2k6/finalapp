# ExpiryGo Web Frontend Configuration (100% Self-Contained / Zero-Paid-API Mode)

# NEXT_PUBLIC_API_URL: API base URL for the backend database server
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Google External APIs Disabled (Uses OpenStreetMap & Leaflet)
NEXT_PUBLIC_GOOGLE_MAPS_PLATFORM_KEY=""
GOOGLE_MAPS_PLATFORM_KEY=""
GEMINI_API_KEY=""

# Google OAuth 2.0 Identity Services (Optional: Paste your Google Client ID here from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""

